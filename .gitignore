# Rust build artifacts
/target/
**/target/

# Cargo lock (keep for binaries, ignore for libraries)
# Cargo.lock is intentionally tracked for this binary crate

# Generated by `cargo fix`
**/*.rs.bk

# Compiled dynamic libraries
*.so
*.dylib
*.dll

# Compiled static libraries
*.a
*.lib

# Executables
*.exe
*.out
*.app

# Build logs and incremental compilation
/target/debug/
/target/release/
/target/doc/
/target/.rustc_info.json
**/.cargo-lock

# Flycheck (used by Emacs / rust-analyzer)
target/flycheck*/

# cargo-audit / cargo-deny
.cargo/advisory-db/

# cargo-tarpaulin coverage reports
tarpaulin-report.html
cobertura.xml

# ── IDE / Editor ──────────────────────────────────────────────────────────────

# JetBrains (RustRover, CLion, IntelliJ)
.idea/
*.iml
*.iws
*.ipr

# VS Code
.vscode/
*.code-workspace

# Vim / Neovim
*.swp
*.swo
*~
.netrwhist

# Emacs
\#*\#
.\#*

# Sublime Text
*.sublime-project
*.sublime-workspace

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encdata
Desktop.ini
$RECYCLE.BIN/
ehthumbs.db
ehthumbs_vista.db

# Linux
.directory
.Trash-*

# ── Project-specific ──────────────────────────────────────────────────────────

# Ridgeback user configuration (generated at runtime, not part of the repo)
ridgeback_config.toml
config.toml

# Log files
*.log
logs/

# Crash dumps / minidumps
*.dmp
*.mdmp

# Shader compilation artifacts (if any tooling generates them)
*.spv
*.spirv

# Lua bytecode
*.luac

# Distribution / packaging
dist/
*.zip
*.tar.gz
*.tar.bz2
*.tar.xz
*.msi
*.deb
*.rpm
*.AppImage

# Benchmark / profile output
perf.data
perf.data.old
flamegraph.svg
*.profraw
*.profdata

# Docs build output
docs/_build/
site/

